{
  "name": "everyseat-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf build bundle kepler-build node_modules package-lock.json generated shaka-setup/shaka-player",
    "postinstall": "cd shaka-setup && ./build.sh && ./copyOutputs.sh",
    "start": "node node_modules/react-native/local-cli/cli.js start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "build:release": "react-native build-kepler --build-type Release",
    "build:debug": "react-native build-kepler --build-type Debug"
  },
  "dependencies": {
    "@amazon-devices/kepler-ui-components": "2.7.1",
    "@amazon-devices/react-linear-gradient": "~2.0.0",
    "@amazon-devices/react-native-async-storage__async-storage": "~2.1.0",
    "@amazon-devices/react-native-kepler": "~2.1.0+rn0.72.0",
    "@amazon-devices/react-native-w3cmedia": "~2.3.2",
    "@react-native-async-storage/async-storage": "1.23.1",
    "base-64": "1.0.0",
    "react": "18.2.0",
    "react-native": "0.72.0",
    "xmldom": "~0.6.0"
  },
  "devDependencies": {
    "@amazon-devices/kepler-cli-platform": "~0.22.0",
    "@babel/core": "~7.22.8",
    "@babel/runtime": "~7.22.8",
    "@react-native-community/cli": "11.3.2",
    "@react-native-community/eslint-config": "~2.0.0",
    "@react-native/eslint-config": "~0.72.2",
    "@react-native/metro-config": "~0.72.6",
    "@trivago/prettier-plugin-sort-imports": "~4.3.0",
    "@types/base-64": "~1.0.2",
    "@types/react": "~18.2.75",
    "@types/xmldom": "~0.1.34",
    "@typescript-eslint/eslint-plugin": "~6.10.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "~8.57.0",
    "eslint-config-prettier": "~6.15.0",
    "eslint-plugin-simple-import-sort": "~5.0.3",
    "metro-react-native-babel-preset": "~0.76.9",
    "npm-run-all": "~4.1.5",
    "prettier": "~2.8.8",
    "prettier-plugin-organize-imports": "~3.2.4",
    "typescript": "~4.9.5"
  },
  "resolutions": {
    "@types/react": "^18"
  },
  "eslintConfig": {
    "extends": "@react-native",
    "root": true,
    "ignorePatterns": [
      "src/w3cmedia/shakaplayer/dist/"
    ]
  },
  "kepler": {
    "projectType": "application",
    "appName": "EverySeat",
    "targets": [
      "tv"
    ],
    "os": [
      "vega"
    ],
    "api": 0.1
  }
}
