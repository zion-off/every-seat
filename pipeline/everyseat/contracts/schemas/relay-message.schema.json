{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "relay-message.schema.json",
  "title": "Relay message",
  "description": "One newline-delimited JSON message on the relay WebSocket, discriminated by `t`.",
  "type": "object",
  "required": ["t"],
  "properties": {
    "t": {
      "enum": ["hello", "ping", "pong", "lens", "household", "clock", "sync?", "sync!"]
    }
  },
  "allOf": [
    {
      "if": { "type": "object", "required": ["t"], "properties": { "t": { "const": "hello" } } },
      "then": { "$ref": "#/$defs/hello" }
    },
    {
      "if": { "type": "object", "required": ["t"], "properties": { "t": { "const": "ping" } } },
      "then": { "$ref": "#/$defs/ping" }
    },
    {
      "if": { "type": "object", "required": ["t"], "properties": { "t": { "const": "pong" } } },
      "then": { "$ref": "#/$defs/pong" }
    },
    {
      "if": { "type": "object", "required": ["t"], "properties": { "t": { "const": "lens" } } },
      "then": { "$ref": "#/$defs/lens" }
    },
    {
      "if": { "type": "object", "required": ["t"], "properties": { "t": { "const": "household" } } },
      "then": { "$ref": "#/$defs/household" }
    },
    {
      "if": { "type": "object", "required": ["t"], "properties": { "t": { "const": "clock" } } },
      "then": { "$ref": "#/$defs/clock" }
    },
    {
      "if": { "type": "object", "required": ["t"], "properties": { "t": { "const": "sync?" } } },
      "then": { "$ref": "#/$defs/syncRequest" }
    },
    {
      "if": { "type": "object", "required": ["t"], "properties": { "t": { "const": "sync!" } } },
      "then": { "$ref": "#/$defs/syncReply" }
    }
  ],
  "$defs": {
    "hello": {
      "description": "Client to relay: connect and declare a role.",
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "role", "household"],
      "properties": {
        "t": { "const": "hello" },
        "role": { "enum": ["tv", "phone", "companion"] },
        "household": { "type": "string" }
      }
    },
    "ping": {
      "description": "Heartbeat, either direction, at least every 25 s.",
      "type": "object",
      "additionalProperties": false,
      "required": ["t"],
      "properties": {
        "t": { "const": "ping" }
      }
    },
    "pong": {
      "description": "Heartbeat reply.",
      "type": "object",
      "additionalProperties": false,
      "required": ["t"],
      "properties": {
        "t": { "const": "pong" }
      }
    },
    "lens": {
      "description": "Companion to TV: the people on the couch and the combined lens.",
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "people", "settings"],
      "properties": {
        "t": { "const": "lens" },
        "people": {
          "type": "array",
          "items": { "$ref": "lens.schema.json#/$defs/person" }
        },
        "settings": {
          "description": "The combined, most protective lens.",
          "$ref": "lens.schema.json#/$defs/settings"
        }
      }
    },
    "household": {
      "description": "Either direction between the TV and the companion: everyone in the household with their comfort settings. The latest `updatedAt` wins; the relay keeps it and replays it to a TV that connects later.",
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "people", "updatedAt"],
      "properties": {
        "t": { "const": "household" },
        "people": {
          "type": "array",
          "maxItems": 7,
          "items": { "$ref": "lens.schema.json#/$defs/person" }
        },
        "updatedAt": {
          "description": "When the list was last changed, in milliseconds since the Unix epoch.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "clock": {
      "description": "TV to phone: sent on play, pause, seek, rate change, and every 2 s.",
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "mediaTime", "wallClock", "rate", "title"],
      "properties": {
        "t": { "const": "clock" },
        "mediaTime": {
          "description": "Media position in seconds.",
          "type": "number"
        },
        "wallClock": {
          "description": "Sender time in the relay's clock (see sync?), in milliseconds since the Unix epoch.",
          "type": "integer"
        },
        "rate": {
          "description": "Playback rate; 0 when paused.",
          "type": "number"
        },
        "title": {
          "description": "Title id.",
          "type": "string"
        }
      }
    },
    "syncRequest": {
      "description": "Phone or TV to relay: clock offset probe.",
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "c"],
      "properties": {
        "t": { "const": "sync?" },
        "c": {
          "description": "Client time in milliseconds when the probe was sent.",
          "type": "integer"
        }
      }
    },
    "syncReply": {
      "description": "Relay to phone or TV: echoes the probe time with the relay's time.",
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "c", "s"],
      "properties": {
        "t": { "const": "sync!" },
        "c": {
          "description": "The client time from the probe.",
          "type": "integer"
        },
        "s": {
          "description": "Relay time in milliseconds when the probe arrived.",
          "type": "integer"
        }
      }
    }
  }
}
